# Configuración del Sistema de Monitoreo (copiar como .env)

# Ruta al modelo de detección de armas (Faster R-CNN)
WEAPON_MODEL_PATH=/home/gbenito/universidad/procesamiento-imagenes-unlu/models/best_model.pth

# Ruta al modelo YOLOv8 para detección de personas
YOLO_MODEL_PATH=/home/gbenito/universidad/procesamiento-imagenes-unlu/src/person_extraction/yolov8n.pt

# Umbral de confianza por defecto (se puede ajustar por cámara)
DEFAULT_CONFIDENCE=0.5

# Puerto opcional para la app Flask (si deseas cambiarlo)
# FLASK_RUN_PORT=5001

# === OPTIMIZACIÓN DE RENDIMIENTO ===
# Ajustar según hardware para balance entre fluidez y precisión

# Resolución del streaming (menor = más fluido, menos detalle)
STREAM_WIDTH=640
STREAM_HEIGHT=480

# FPS objetivo del streaming
STREAM_FPS=15

# Frame skipping: procesar 1 de cada (N+1) frames para inferencia
# Recomendaciones:
#   FRAME_SKIP=9  → Procesa 1 de cada 10 (CPU muy débil)
#   FRAME_SKIP=4  → Procesa 1 de cada 5 (CPU normal, valor por defecto)
#   FRAME_SKIP=2  → Procesa 1 de cada 3 (CPU potente)
#   FRAME_SKIP=0  → Procesa todos los frames (GPU/CPU muy potente)
FRAME_SKIP=4

# Calidad JPEG del streaming (1-100)
# Menor = más compresión/velocidad, mayor = mejor calidad/más lag
JPEG_QUALITY=75

